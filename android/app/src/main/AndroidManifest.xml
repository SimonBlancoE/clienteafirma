<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Trámites web (servidor intermedio, firma trifásica), sellos de tiempo y OCSP. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- DNIe por NFC (modo lector). -->
    <uses-permission android:name="android.permission.NFC" />

    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- Interfaz egui con OpenGL ES 2.0 o superior. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoFirma">

        <!--
            Actividad única. singleTask: los intents afirma:// llegan a la instancia existente
            (onNewIntent) y nunca se crea una segunda actividad en el mismo proceso. configChanges:
            Android no recrea la actividad al girar, cambiar de tamaño o de idioma (egui se
            adapta solo).
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|touchscreen|uiMode|locale|layoutDirection|fontScale|fontWeightAdjustment|colorMode|mcc|mnc"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="android.app.lib_name"
                android:value="autofirma_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Invocación desde las páginas web de las administraciones (autoscript.js). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="afirma" />
            </intent-filter>
        </activity>
    </application>

</manifest>
