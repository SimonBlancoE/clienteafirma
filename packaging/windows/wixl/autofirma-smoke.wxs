<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI de PRUEBA para wixl (msitools, sintaxis WiX v3) que se puede generar desde Linux con
  tools/package/windows-cross.sh (opción msi). Solo sirve para comprobar el contenido y
  el flujo de empaquetado: no ejecuta la configuración del sistema (wixl no admite las
  acciones personalizadas de WixToolset.Util). El instalador real es
  packaging/windows/autofirma.wxs (WiX v4/v5) y se genera en Windows.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="AutoFirma (prueba)"
           Language="3082"
           Codepage="1252"
           Version="$(var.Version)"
           Manufacturer="AutoFirma-rs"
           UpgradeCode="48D90D3A-830C-4DA9-8F3C-D4E2ADE9EE89">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="AutoFirma: compilación de prueba" Comments="MSI de prueba generado con wixl" />
    <Media Id="1" Cabinet="autofirma.cab" EmbedCab="yes" />

    <Icon Id="AutoFirmaIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AutoFirmaIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="AutoFirma-rs">
          <Component Id="AutofirmaExeComponent" Guid="*" Win64="yes">
            <File Id="AutofirmaExe" Name="autofirma.exe" Source="$(var.BinDir)/autofirma.exe" KeyPath="yes" />
          </Component>
          <Component Id="LicenseComponent" Guid="*" Win64="yes">
            <File Id="LicenseGpl" Name="LICENSE-gpl-2.0.txt" Source="$(var.LicenseFile)" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcutComponent" Guid="7C2C5E43-2F4B-4E0B-9E43-6D0D3A9B1A21">
          <Shortcut Id="StartMenuShortcut" Name="AutoFirma" Target="[INSTALLFOLDER]autofirma.exe" WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\AutoFirma-rs" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="AutoFirma" Level="1">
      <ComponentRef Id="AutofirmaExeComponent" />
      <ComponentRef Id="LicenseComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>
  </Product>
</Wix>
