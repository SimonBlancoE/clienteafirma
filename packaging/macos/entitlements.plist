<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Derechos de AutoFirma.app con «hardened runtime» (obligatorio para la notarización).

  disable-library-validation: AutoFirma carga en su proceso bibliotecas PKCS#11 de terceros
  (OpenSC, controladores de tarjetas y del DNIe) y la biblioteca NSS de Firefox, que no
  están firmadas por el mismo equipo de desarrollo; sin este derecho macOS impediría
  cargarlas.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
