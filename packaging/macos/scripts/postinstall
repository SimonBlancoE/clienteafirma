#!/bin/sh
# postinstall del paquete AutoFirma.pkg (se ejecuta como root). Integra AutoFirma con el
# sistema: CA local y certificado SSL de 127.0.0.1 en el llavero del sistema, Firefox,
# protocolo afirma:// y, si se pide en «/Library/Application Support/AutoFirma/install.conf»,
# directivas de navegadores. Ver configure-hook.sh.
#
# $1 = ruta del paquete, $2 = destino (/Applications), $3 = volumen de destino.

target_volume="${3:-/}"
if [ "$target_volume" != "/" ]; then
    echo "autofirma-rs: instalación en otro volumen ($target_volume); no se configura el sistema"
    exit 0
fi

app="${2:-/Applications}/AutoFirma.app"
"$(dirname "$0")/configure-hook.sh" install "$app/Contents/MacOS/autofirma"
status=$?

# LaunchServices es por usuario y el registro que hace root llega a la base de datos del
# usuario con retraso: se registra también en la sesión de quien está ante el equipo, para
# que afirma:// funcione en cuanto termina la instalación.
lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
user="$(stat -f %Su /dev/console 2>/dev/null || true)"
if [ -n "$user" ] && [ "$user" != "root" ] && [ -x "$lsregister" ]; then
    uid="$(id -u "$user" 2>/dev/null || true)"
    if [ -n "$uid" ]; then
        launchctl asuser "$uid" sudo -u "$user" "$lsregister" -f -R -trusted "$app" \
            || echo "autofirma-rs: AVISO: no se ha podido registrar AutoFirma en LaunchServices para $user"
    fi
fi
exit "$status"
