<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><r><xsl:value-of select="//book"/>|<xsl:value-of select="//nada"/>|<xsl:value-of select="//@year"/>|<xsl:value-of select="count(//book)"/>|<xsl:value-of select="//book[1]/@x:lang" xmlns:x="urn:x"/>|<xsl:value-of select="//comment()"/>|<xsl:value-of select="//processing-instruction()"/>|<xsl:value-of select="1=1"/></r></xsl:template></xsl:stylesheet>
