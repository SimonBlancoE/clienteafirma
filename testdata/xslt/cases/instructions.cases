<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:e="urn:ext" extension-element-prefixes="e"><xsl:template match="/"><r><e:foo><xsl:fallback>fb</xsl:fallback></e:foo></r></xsl:template></xsl:stylesheet>
#### extension_element_lre
