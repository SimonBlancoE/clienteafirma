<xsl:stylesheet version="1.1" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><r><xsl:nueva><xsl:fallback>fb1</xsl:fallback><xsl:fallback>fb2</xsl:fallback></xsl:nueva><xsl:if test="true()"><xsl:fallback>no</xsl:fallback>si</xsl:if></r></xsl:template></xsl:stylesheet>
