#### variable_types_in_value_of
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:variable name="nodes" select="//v"/><xsl:variable name="num" select="2.50"/><xsl:variable name="bool" select="1 = 1"/><xsl:template match="/"><r><xsl:value-of select="$nodes"/>|<xsl:value-of select="$num"/>|<xsl:value-of select="$bool"/>|<xsl:value-of select="$nodes[2] + $num"/></r></xsl:template></xsl:stylesheet>
#### deep_path
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><r><xsl:value-of select="count(/doc/*[self::n or self::v][position() mod 2 = 0])"/>|<xsl:value-of select="name(/*/*[last()]/*)"/>|<xsl:value-of select="count(//*/..)"/>|<xsl:value-of select="count(/descendant::*/ancestor::*)"/></r></xsl:template></xsl:stylesheet>
