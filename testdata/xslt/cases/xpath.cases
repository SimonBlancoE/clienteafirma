#### lang
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><r><xsl:for-each select="//s|//t|//u"><xsl:value-of select="concat(lang('en'), lang('EN-gb'), lang('es'), lang('e'), lang('en-'), lang('english'), ' ')"/></xsl:for-each></r></xsl:template></xsl:stylesheet>
#### axes
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><r><xsl:for-each select="//v[2]"><xsl:value-of select="concat(count(preceding::*), count(following::*), count(preceding-sibling::*), count(following-sibling::*), count(ancestor::*), count(ancestor-or-self::*), count(descendant::*), count(../descendant-or-self::*), name(preceding-sibling::*[1]), name(following-sibling::*[last()]), name(ancestor::*[1]), name(..), count(self::v), count(self::n))"/></xsl:for-each>|<xsl:value-of select="count(//@*)"/>|<xsl:value-of select="count(//node())"/>|<xsl:value-of select="count(//text())"/>|<xsl:value-of select="name((//v)[last()]/preceding::n[1])"/>|<xsl:value-of select="(//v | //n)[1]"/>|<xsl:value-of select="count(//v/.. | //n/..)"/></r></xsl:template></xsl:stylesheet>
#### predicates
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><r><xsl:value-of select="concat(//n[2], '|', //n[last()], '|', (//n)[2], '|', //n[position() &gt; 13][1], '|', count(//n[. = 'NaN' or . = '-']), '|', //v[. &gt; 3][1], '|', //n[number(.) = number(.)][3], '|', count(//*[2]), '|', (//v)[0 div 0], '|', //v['x'][1], '|', //v[1.0])"/></r></xsl:template></xsl:stylesheet>
#### id_function
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><r><xsl:value-of select="count(id('a b c'))"/>|<xsl:value-of select="id('b')/@v"/>|<xsl:for-each select="id(//ref)"><xsl:value-of select="@i"/></xsl:for-each>|<xsl:value-of select="count(id('x1'))"/></r></xsl:template></xsl:stylesheet>
====
<!DOCTYPE doc [<!ATTLIST e i ID #IMPLIED v CDATA "def"><!ATTLIST f xml:id ID #IMPLIED>]><doc><e i="a" v="1"/><e i="b"/><e Id="c"/><ref>a c</ref><ref>b</ref><f xml:id="x1"/></doc>
#### dtd_defaults
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><xsl:copy-of select="/"/></xsl:template></xsl:stylesheet>
====
<?xml version="1.0"?>
<!DOCTYPE doc [
  <!ELEMENT doc ANY>
  <!ATTLIST e a CDATA "x" b CDATA #FIXED "fijo" c NMTOKENS "  t1   t2 " d CDATA #IMPLIED>
  <!ENTITY ent "texto &amp; más">
]>
<doc><e/><e a="dado"/>&ent;<!-- comentario --></doc>
