<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><xsl:variable name="m" select="1000000"/><xsl:variable name="k" select="$m * 3"/><r><xsl:value-of select="$m * $m"/>|<xsl:value-of select="$k * $k"/>|<xsl:value-of select="round(1000000) * 1000000"/>|<xsl:value-of select="number(1000000) * 1000000"/>|<xsl:value-of select="floor(2.5) * 1000000000"/>|<xsl:value-of select="1.0 * 1000000 * 1000000"/></r></xsl:template></xsl:stylesheet>
#### arithmetic
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><r><xsl:value-of select="concat(5 mod 3, ' ', -5 mod 3, ' ', 5 mod -3, ' ', 5.5 mod 2, ' ', 1 div 0 mod 2, ' ', 7 div 2, ' ', - - 3, ' ', 2 - -1, ' ', sum(//v), ' ', sum(//v[. != 'x']), ' ', sum(/nada), ' ', floor(-1.5), ' ', ceiling(-1.5), ' ', round(-1.5), ' ', round(1.5), ' ', round(0.49999999999999994), ' ', round(-0.4), ' ', round(1 div 0), ' ', round(0 div 0))"/></r></xsl:template></xsl:stylesheet>
#### string_functions
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><r><xsl:value-of select="concat(substring('12345', 1.5, 2.6), '|', substring('12345', 0, 3), '|', substring('12345', 0 div 0, 3), '|', substring('12345', -1 div 0, 1 div 0), '|', substring('12345', 2), '|', substring('12345', -3), '|', substring('a&#x10437;b', 2, 1), '|', string-length('aé&#x10437;'), '|', translate('bar','abc','ABC'), '|', translate('aaa','a',''), '|', normalize-space('  a &#9; b&#10;'), '|', substring-before('1999/04/01','/'), '|', substring-after('1999/04/01','/'), '|', substring-after('abc', ''), '|', starts-with('abc', ''), '|', contains('abc', 'bc'), '|', concat('a', 1, true()), '|', string(), '|', string(1 div 0), '|', normalize-space(//s))"/></r></xsl:template></xsl:stylesheet>
