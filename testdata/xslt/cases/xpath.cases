XPath en XSLTC: funciones, conversiones de números (Double.valueOf y
realToString), aritmética entera de Java, comparaciones, ejes y uniones.

#### @input
<doc><n>1e3</n><n> 12 </n><n>+1</n><n>1.</n><n>.5</n><n>1d</n><n>0x10</n><n>Infinity</n><n>-</n><n>-0</n><n>1,5</n><n>NaN</n><n>-.5f</n><n>12abc</n><n>0x1p3</n><v>3</v><v>7</v><v>x</v><s xml:lang="en-GB">Hola  Mundo
 fin</s><t xml:lang="es"><u/></t></doc>
#### numbers_from_strings
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><r><xsl:for-each select="//n"><xsl:value-of select="number(.)"/>,<xsl:value-of select=". * 1"/>,<xsl:value-of select=". = 12"/>;</xsl:for-each></r></xsl:template></xsl:stylesheet>
#### number_to_string
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><r><xsl:value-of select="concat(1 div 3, ' ', 0.1+0.2, ' ', 10000000, ' ', 9999999.5, ' ', 12345678.9, ' ', 0.0001, ' ', 0.001, ' ', 0.00099, ' ', -0, ' ', 1 div 0, ' ', -1 div 0, ' ', 0 div 0, ' ', 100 * 1.1, ' ', 5 div 2, ' ', 0.000001234, ' ', 1 div 7 * 1000000000, ' ', 3.0, ' ', 4.35, ' ', 0.3 - 0.1, ' ', 2 * 0.000001, ' ', 1000000000 * 1000000000000, ' ', 123456789012.5, ' ', -0.5, ' ', 1 div 3 * 1000000000.0 * 1000000000000)"/></r></xsl:template></xsl:stylesheet>
